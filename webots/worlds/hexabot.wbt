#VRML_SIM R2025a utf8

EXTERNPROTO "../protos/Hexabot.proto"

WorldInfo {
  info [
    "HEXABOT - UNSTA. Hexapodo simplificado a 6 motores (coxas)"
    "controlado por TCP/IP con el protocolo serie del Arduino original."
  ]
  title "HEXABOT"
  basicTimeStep 8
  contactProperties [
    ContactProperties {
      material2 "pie"
      coulombFriction [
        0.6
      ]
      softCFM 0.0001
    }
  ]
}
Viewpoint {
  orientation 0.3 -0.2 -0.93 4.4
  position -1.6 -3.6 2.6
  follow "HEXABOT"
}
Background {
  skyColor [
    0.78 0.85 0.92
  ]
}
DirectionalLight {
  direction -0.4 0.3 -1
  intensity 2.5
  castShadows TRUE
}
DirectionalLight {
  direction 0.5 -0.2 -0.6
  intensity 0.8
}
DEF PISO Solid {
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.85 0.85 0.82
        roughness 1
        metalness 0
      }
      geometry DEF PLANO Plane {
        size 20 20
      }
    }
    # Líneas cada 1 m sobre el eje Y (dirección de avance) para ver el desplazamiento
    Pose {
      translation 0 0 0.001
      children [
        Shape {
          appearance DEF LINEA PBRAppearance {
            baseColor 0.2 0.3 0.7
            roughness 1
            metalness 0
          }
          geometry Box {
            size 6 0.02 0.001
          }
        }
      ]
    }
    Pose {
      translation 0 1 0.001
      children [
        Shape {
          appearance USE LINEA
          geometry Box {
            size 6 0.02 0.001
          }
        }
      ]
    }
    Pose {
      translation 0 2 0.001
      children [
        Shape {
          appearance USE LINEA
          geometry Box {
            size 6 0.02 0.001
          }
        }
      ]
    }
    Pose {
      translation 0 3 0.001
      children [
        Shape {
          appearance USE LINEA
          geometry Box {
            size 6 0.02 0.001
          }
        }
      ]
    }
    Pose {
      translation 0 -1 0.001
      children [
        Shape {
          appearance USE LINEA
          geometry Box {
            size 6 0.02 0.001
          }
        }
      ]
    }
    Pose {
      translation 0 0 0.001
      children [
        Shape {
          appearance USE LINEA
          geometry Box {
            size 0.02 6 0.001
          }
        }
      ]
    }
  ]
  name "piso"
  boundingObject USE PLANO
}
Hexabot {
  controllerArgs [
    "--host=127.0.0.1"
    "--puerto=5000"
  ]
}
